{"id":"term.kotlin.null-safety","termType":"concept","displayName":{"zh-CN":"空安全","en":"Null safety"},"aliases":[{"text":"null safety","lang":"en","matchType":"exact"},{"text":"空安全","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"Kotlin 在类型系统区分可空与非空引用，让大多数空指针访问在编译期暴露。","en":"Kotlin distinguishes nullable and non-nullable references in the type system so most null accesses surface at compile time."},"syntaxRef":"syntax/kotlin.json#null-safety","exampleIds":["example.kotlin.null-safety","example.kotlin.elvis"],"relatedTermIds":["term.kotlin.nullable-type","term.kotlin.safe-call","term.kotlin.elvis-operator","term.kotlin.not-null-assertion"],"topicIds":["kotlin.basics.null-safety"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
{"id":"term.kotlin.nullable-type","termType":"syntax","displayName":{"zh-CN":"可空类型","en":"Nullable type"},"aliases":[{"text":"nullable type","lang":"en","matchType":"exact"},{"text":"可空类型","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"形如 String? 的类型，表示值可能为 null，使用前必须处理空值。","en":"A type such as String? that may hold null and must be handled before use."},"syntaxRef":"syntax/kotlin.json#nullable-type","exampleIds":["example.kotlin.null-safety"],"relatedTermIds":["term.kotlin.null-safety","term.kotlin.safe-call","term.kotlin.not-null-assertion"],"topicIds":["kotlin.basics.null-safety"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
{"id":"term.kotlin.safe-call","termType":"syntax","displayName":{"zh-CN":"安全调用","en":"Safe call"},"aliases":[{"text":"safe call","lang":"en","matchType":"exact"},{"text":"安全调用","lang":"zh-CN","matchType":"exact"},{"text":"?.","lang":"en","matchType":"abbr"}],"definitions":{"zh-CN":"安全调用运算符 ?. 只在接收者非空时执行调用，否则整个表达式返回 null。","en":"The safe-call operator ?. invokes the call only when the receiver is non-null; otherwise the whole expression is null."},"syntaxRef":"syntax/kotlin.json#safe-call","exampleIds":["example.kotlin.null-safety"],"relatedTermIds":["term.kotlin.nullable-type","term.kotlin.elvis-operator"],"topicIds":["kotlin.basics.null-safety"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
