{"id":"term.networking.cache-control","termType":"syntax","displayName":{"zh-CN":"Cache-Control","en":"Cache-Control"},"aliases":[{"text":"Cache-Control","lang":"en","matchType":"exact"},{"text":"缓存控制头","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"声明缓存能力与新鲜度的响应头，如 max-age、no-store、must-revalidate。","en":"A response header declaring cacheability and freshness, such as max-age, no-store and must-revalidate."},"syntaxRef":null,"exampleIds":["example.networking.cache-headers"],"relatedTermIds":["term.networking.etag","term.networking.header"],"topicIds":["networking.http.caching"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
