{"id":"term.networking.rate-limit","termType":"concept","displayName":{"zh-CN":"限流","en":"Rate limit"},"aliases":[{"text":"rate limit","lang":"en","matchType":"exact"},{"text":"速率限制","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"服务端限制单位时间内的请求数量，超出时返回 429，客户端应按 Retry-After 等待。","en":"A server limit on requests per unit of time; exceeding it returns 429 and the client should wait according to Retry-After."},"syntaxRef":null,"exampleIds":["example.networking.bearer-auth"],"relatedTermIds":["term.networking.status-code","term.networking.retry-backoff"],"topicIds":["networking.api.auth"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
