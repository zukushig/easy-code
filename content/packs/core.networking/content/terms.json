{"id":"term.networking.timeout","termType":"concept","displayName":{"zh-CN":"超时","en":"Timeout"},"aliases":[{"text":"timeout","lang":"en","matchType":"exact"},{"text":"请求超时","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"等待连接或响应的最长时间，避免请求永久挂起占用资源。","en":"The maximum time to wait for a connection or response, preventing requests from hanging forever."},"syntaxRef":null,"exampleIds":["example.networking.timeout"],"relatedTermIds":["term.networking.retry-backoff","term.networking.tcp"],"topicIds":["networking.reliability.timeout-retry"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
{"id":"term.networking.retry-backoff","termType":"concept","displayName":{"zh-CN":"重试与退避","en":"Retry and backoff"},"aliases":[{"text":"retry","lang":"en","matchType":"exact"},{"text":"exponential backoff","lang":"en","matchType":"exact"},{"text":"指数退避","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"失败后延迟重发的策略：次数有上限、间隔按指数增长并加抖动，避免雪崩式重试。","en":"A delayed-resend strategy: bounded attempts with exponentially growing delays plus jitter to avoid retry storms."},"syntaxRef":null,"exampleIds":["example.networking.retry-backoff"],"relatedTermIds":["term.networking.timeout","term.networking.idempotency"],"topicIds":["networking.reliability.timeout-retry","networking.reliability.idempotency"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
{"id":"term.networking.idempotency","termType":"concept","displayName":{"zh-CN":"幂等性","en":"Idempotency"},"aliases":[{"text":"idempotency","lang":"en","matchType":"exact"},{"text":"幂等","lang":"zh-CN","matchType":"exact"},{"text":"idempotency key","lang":"en","matchType":"exact"}],"definitions":{"zh-CN":"同一请求重复执行多次与执行一次效果相同的性质；POST 创建需用幂等键补足。","en":"The property that repeating a request has the same effect as executing it once; create-style POSTs need an idempotency key."},"syntaxRef":null,"exampleIds":["example.networking.idempotency"],"relatedTermIds":["term.networking.method","term.networking.retry-backoff"],"topicIds":["networking.reliability.idempotency"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
{"id":"term.networking.https","termType":"concept","displayName":{"zh-CN":"HTTPS","en":"HTTPS"},"aliases":[{"text":"HTTPS","lang":"en","matchType":"exact"},{"text":"HTTP over TLS","lang":"en","matchType":"exact"},{"text":"安全超文本传输协议","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"在 TLS 之上运行的 HTTP，提供加密、完整性保护与服务器身份验证。","en":"HTTP running over TLS, providing encryption, integrity protection and server authentication."},"syntaxRef":null,"exampleIds":["example.networking.tls-check"],"relatedTermIds":["term.networking.tls-certificate","term.networking.http"],"topicIds":["networking.security.https-tls"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
{"id":"term.networking.tls-certificate","termType":"concept","displayName":{"zh-CN":"TLS 证书","en":"TLS certificate"},"aliases":[{"text":"certificate","lang":"en","matchType":"exact"},{"text":"TLS certificate","lang":"en","matchType":"exact"},{"text":"数字证书","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"由受信任 CA 签发的身份凭据；过期、域名不匹配或链不完整都会导致校验失败。","en":"An identity credential signed by a trusted CA; expiry, hostname mismatch or an incomplete chain make validation fail."},"syntaxRef":null,"exampleIds":["example.networking.tls-check"],"relatedTermIds":["term.networking.https","term.networking.dns"],"topicIds":["networking.security.https-tls"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
{"id":"term.networking.sse","termType":"syntax","displayName":{"zh-CN":"SSE","en":"SSE"},"aliases":[{"text":"SSE","lang":"en","matchType":"exact"},{"text":"Server-Sent Events","lang":"en","matchType":"exact"},{"text":"服务器推送事件","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"用 text/event-stream 以文本事件流持续推送数据，格式为 data:/event:/id: 行加空行分隔。","en":"A text event stream over text/event-stream, formatted as data:/event:/id: lines separated by blank lines."},"syntaxRef":null,"exampleIds":["example.networking.sse-parse"],"relatedTermIds":["term.networking.response","term.networking.http"],"topicIds":["networking.streaming.sse"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
