        {"text": "pattern recognition", "lang": "en", "matchType": "exact"}
      ],
      "definitions": {"zh-CN": "模式识别是在多个具体问题中发现重复出现的结构，从而用统一的方法解决它们。", "en": "Pattern recognition finds recurring structures across concrete problems so one general solution can handle them."},
      "syntaxRef": null,
      "exampleIds": ["example.thinking.pattern-recognition"],
