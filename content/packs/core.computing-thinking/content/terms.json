        {"text": "抽象", "lang": "zh-CN", "matchType": "exact"},
        {"text": "abstraction", "lang": "en", "matchType": "exact"}
      ],
      "definitions": {"zh-CN": "抽象是忽略与目标无关的细节、只保留关键特征，用函数或接口隐藏实现。", "en": "Abstraction hides irrelevant details while keeping key features, typically behind a function or interface."},
      "syntaxRef": null,
