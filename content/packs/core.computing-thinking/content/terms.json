        {"text": "分解", "lang": "zh-CN", "matchType": "exact"},
        {"text": "decomposition", "lang": "en", "matchType": "exact"}
      ],
      "definitions": {"zh-CN": "分解是把大问题拆成更小、可独立解决和验证的子问题。", "en": "Decomposition breaks a large problem into smaller sub-problems that can be solved and verified separately."},
