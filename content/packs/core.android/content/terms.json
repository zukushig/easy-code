{"id":"term.android.state-hoisting","termType":"concept","displayName":{"zh-CN":"状态提升","en":"State hoisting"},"aliases":[{"text":"state hoisting","lang":"en","matchType":"exact"},{"text":"状态提升","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"把子组件状态上移到共同父级，子组件改为接收值与事件回调，从而无状态、可复用。","en":"Moving child state up to a common parent so the child receives values and callbacks and becomes stateless and reusable."},"syntaxRef":null,"exampleIds":["example.android.state-hoisting"],"relatedTermIds":["term.android.state","term.android.remember"],"topicIds":["android.compose.state-hoisting"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
