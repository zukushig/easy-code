{"id":"term.android.compose","termType":"concept","displayName":{"zh-CN":"Jetpack Compose","en":"Jetpack Compose"},"aliases":[{"text":"Compose","lang":"en","matchType":"exact"},{"text":"Compose","lang":"zh-CN","matchType":"exact"},{"text":"声明式 UI 工具包","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"Android 的声明式 UI 工具包：用组合函数描述界面，由框架负责差异更新。","en":"Android's declarative UI toolkit: compose the UI from functions and let the framework apply the differences."},"syntaxRef":null,"exampleIds":["example.android.composable-counter"],"relatedTermIds":["term.android.composable","term.android.state"],"topicIds":["android.compose.declarative-ui"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
{"id":"term.android.composable","termType":"concept","displayName":{"zh-CN":"@Composable 函数","en":"@Composable function"},"aliases":[{"text":"composable","lang":"en","matchType":"exact"},{"text":"组合函数","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"带 @Composable 注解、用于描述一段界面的函数；只能被其他组合函数调用。","en":"A function annotated with @Composable that describes part of the UI and can only be called from another composable."},"syntaxRef":null,"exampleIds":["example.android.composable-counter","example.android.lazy-column"],"relatedTermIds":["term.android.compose","term.android.recomposition"],"topicIds":["android.compose.declarative-ui","android.compose.lazy-lists"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
{"id":"term.android.state","termType":"concept","displayName":{"zh-CN":"界面状态","en":"UI state"},"aliases":[{"text":"UI state","lang":"en","matchType":"exact"},{"text":"界面状态","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"驱动界面显示的可观察数据；状态改变会触发读取它的组合函数重组。","en":"Observable data that drives the UI; changing it triggers recomposition of the composables that read it."},"syntaxRef":null,"exampleIds":["example.android.composable-counter","example.android.state-hoisting"],"relatedTermIds":["term.android.remember","term.android.state-hoisting"],"topicIds":["android.compose.state-remember","android.compose.state-hoisting"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
{"id":"term.android.remember","termType":"api","displayName":{"zh-CN":"remember","en":"remember"},"aliases":[{"text":"remember","lang":"en","matchType":"exact"},{"text":"记忆","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"remember 让计算出的值在重组之间保留；依赖变化时可用 key 重新计算。","en":"remember keeps a computed value across recompositions; keys let it recompute when inputs change."},"syntaxRef":null,"exampleIds":["example.android.composable-counter"],"relatedTermIds":["term.android.mutable-state","term.android.state-hoisting"],"topicIds":["android.compose.state-remember"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
