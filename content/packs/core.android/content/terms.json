{"id":"term.android.lifecycle","termType":"concept","displayName":{"zh-CN":"生命周期","en":"Lifecycle"},"aliases":[{"text":"lifecycle","lang":"en","matchType":"exact"},{"text":"生命周期","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"组件从创建到销毁的状态序列；在成对的回调里申请与释放资源可避免泄漏。","en":"The state sequence of a component from creation to destruction; acquire and release resources in paired callbacks to avoid leaks."},"syntaxRef":null,"exampleIds":["example.android.lifecycle-observer"],"relatedTermIds":["term.android.activity","term.android.configuration-change"],"topicIds":["android.activity.lifecycle"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
