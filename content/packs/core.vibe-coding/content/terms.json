{"terms":[
{"id":"term.vibe.vibe-coding","termType":"concept","displayName":{"zh-CN":"Vibe Coding","en":"Vibe Coding"},"aliases":[{"text":"Vibe Coding","lang":"en","matchType":"exact"},{"text":"氛围编程","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"用自然语言与 AI 协作写代码的实践，核心不是「让 AI 写完」，而是清晰表达、逐步验证与人工负责。","en":"The practice of building software by collaborating with AI through natural language; the core is clear expression, stepwise verification and human accountability, not just letting the AI finish."},"syntaxRef":"syntax/prompt.json#vibe-coding","exampleIds":["example.vibe.verify-before-claim"],"relatedTermIds":["term.vibe.ai-generated-code","term.vibe.verification"],"topicIds":["vibe-coding.foundations.generate-vs-verify"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
{"id":"term.vibe.ai-generated-code","termType":"concept","displayName":{"zh-CN":"AI 生成代码","en":"AI-generated code"},"aliases":[{"text":"AI-generated code","lang":"en","matchType":"exact"},{"text":"AI 生成代码","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"模型给出的代码候选，未经运行与审查前只是草稿，不能当作已完成的功能。","en":"A code candidate produced by a model; before execution and review it is only a draft, not a completed feature."},"syntaxRef":"syntax/prompt.json#ai-generated-code","exampleIds":["example.vibe.iterative-prompt-chain"],"relatedTermIds":["term.vibe.vibe-coding","term.vibe.verification"],"topicIds":["vibe-coding.foundations.generate-vs-verify","vibe-coding.prompt.iterative"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
{"id":"term.vibe.verification","termType":"concept","displayName":{"zh-CN":"验证","en":"Verification"},"aliases":[{"text":"verification","lang":"en","matchType":"exact"},{"text":"验证","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"用可复现的命令、测试或观察确认改动符合预期；验证结果必须来自实际执行而不是模型声明。","en":"Confirming a change meets expectations through reproducible commands, tests or observation; the result must come from actual execution, not a model claim."},"syntaxRef":"syntax/prompt.json#verification","exampleIds":["example.vibe.verify-before-claim"],"relatedTermIds":["term.vibe.ai-generated-code","term.vibe.test-evidence"],"topicIds":["vibe-coding.foundations.generate-vs-verify","vibe-coding.review.diff","vibe-coding.requirements.acceptance-criteria"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
{"id":"term.vibe.no-verify-no-claim","termType":"concept","displayName":{"zh-CN":"未验证不下结论","en":"No verification, no claim"},"aliases":[{"text":"no verification no claim","lang":"en","matchType":"exact"},{"text":"未验证不下结论","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"没有证据就不写「已完成」「已修复」；只能写「未验证」并说明还缺什么证据。","en":"Without evidence never write done or fixed; mark it unverified and state which evidence is still missing."},"syntaxRef":"syntax/prompt.json#no-verify-no-claim","exampleIds":["example.vibe.verify-before-claim"],"relatedTermIds":["term.vibe.verification","term.vibe.test-evidence"],"topicIds":["vibe-coding.foundations.generate-vs-verify"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
{"id":"term.vibe.requirement-clarification","termType":"concept","displayName":{"zh-CN":"需求澄清","en":"Requirement clarification"},"aliases":[{"text":"requirement clarification","lang":"en","matchType":"exact"},{"text":"需求澄清","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"编码前把目标、输入输出、边界与不做事项问清楚，并要求 AI 复述理解。","en":"Clarifying goal, inputs and outputs, boundaries and out-of-scope items before coding, and asking the AI to restate its understanding."},"syntaxRef":"syntax/prompt.json#requirement-clarification","exampleIds":["example.vibe.clarify-prompt"],"relatedTermIds":["term.vibe.acceptance-criteria","term.vibe.plan-mode"],"topicIds":["vibe-coding.requirements.clarify","vibe-coding.workflow.plan-first"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
{"id":"term.vibe.acceptance-criteria","termType":"concept","displayName":{"zh-CN":"验收标准","en":"Acceptance criteria"},"aliases":[{"text":"acceptance criteria","lang":"en","matchType":"exact"},{"text":"验收标准","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"对功能结果的可观察、可判定描述，是判断任务是否完成的依据。","en":"Observable, decidable statements about a feature's outcome that determine whether the task is complete."},"syntaxRef":"syntax/prompt.json#acceptance-criteria","exampleIds":["example.vibe.acceptance-criteria"],"relatedTermIds":["term.vibe.definition-of-done","term.vibe.verification"],"topicIds":["vibe-coding.requirements.clarify","vibe-coding.requirements.acceptance-criteria"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
{"id":"term.vibe.definition-of-done","termType":"concept","displayName":{"zh-CN":"完成定义","en":"Definition of done"},"aliases":[{"text":"definition of done","lang":"en","matchType":"exact"},{"text":"完成定义","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"任务关闭前必须满足的清单，如测试通过、diff 已审、文档已更新、无密钥泄露。","en":"The checklist a task must satisfy before closing, such as tests passing, diff reviewed, docs updated and no secret leakage."},"syntaxRef":"syntax/prompt.json#definition-of-done","exampleIds":["example.vibe.acceptance-criteria"],"relatedTermIds":["term.vibe.acceptance-criteria","term.vibe.checkpoint"],"topicIds":["vibe-coding.requirements.acceptance-criteria"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
{"id":"term.vibe.context-minimization","termType":"concept","displayName":{"zh-CN":"上下文最小化","en":"Context minimization"},"aliases":[{"text":"context minimization","lang":"en","matchType":"exact"},{"text":"上下文最小化","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"只提供完成当前任务所需的最少材料，减少无关信息与敏感数据的暴露。","en":"Providing only the minimum material needed for the current task, reducing noise and exposure of sensitive data."},"syntaxRef":"syntax/prompt.json#context-minimization","exampleIds":["example.vibe.context-bundle"],"relatedTermIds":["term.vibe.context-bundle"],"topicIds":["vibe-coding.context.minimal"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
{"id":"term.vibe.context-bundle","termType":"concept","displayName":{"zh-CN":"上下文包","en":"Context bundle"},"aliases":[{"text":"context bundle","lang":"en","matchType":"exact"},{"text":"上下文包","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"一次请求中随 prompt 附带的材料集合：相关代码片段、完整报错、环境信息，明确列出且可核对。","en":"The material attached to one prompt: relevant code excerpts, full errors and environment info, listed explicitly and verifiable."},"syntaxRef":"syntax/prompt.json#context-bundle","exampleIds":["example.vibe.context-bundle"],"relatedTermIds":["term.vibe.context-minimization","term.vibe.requirement-clarification"],"topicIds":["vibe-coding.context.minimal"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
{"id":"term.vibe.prompt-iteration","termType":"concept","displayName":{"zh-CN":"迭代提示","en":"Iterative prompting"},"aliases":[{"text":"iterative prompting","lang":"en","matchType":"exact"},{"text":"迭代提示","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"一次只提出一个可验证目标的提示方式，根据上一轮真实结果决定下一轮请求。","en":"Prompting one verifiable goal at a time and deciding the next request from the previous round's real results."},"syntaxRef":"syntax/prompt.json#prompt-iteration","exampleIds":["example.vibe.iterative-prompt-chain"],"relatedTermIds":["term.vibe.small-steps","term.vibe.ai-generated-code"],"topicIds":["vibe-coding.prompt.iterative"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
{"id":"term.vibe.small-steps","termType":"concept","displayName":{"zh-CN":"小步迭代","en":"Small-step iteration"},"aliases":[{"text":"small steps","lang":"en","matchType":"exact"},{"text":"小步迭代","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"把改动拆小到可独立审查、验证与回滚，一次只做一件事。","en":"Splitting changes small enough to review, verify and revert independently, doing one thing at a time."},"syntaxRef":"syntax/prompt.json#small-steps","exampleIds":["example.vibe.small-step-prompt"],"relatedTermIds":["term.vibe.atomic-commit","term.vibe.checkpoint"],"topicIds":["vibe-coding.iteration.small-steps"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
{"id":"term.vibe.atomic-commit","termType":"concept","displayName":{"zh-CN":"原子提交","en":"Atomic commit"},"aliases":[{"text":"atomic commit","lang":"en","matchType":"exact"},{"text":"原子提交","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"一个提交只包含一个可解释、可独立回滚的改动，提交信息说明做了什么与如何验证。","en":"A commit containing one explainable, independently revertible change, with a message stating what changed and how it was verified."},"syntaxRef":"syntax/prompt.json#atomic-commit","exampleIds":["example.vibe.small-step-prompt"],"relatedTermIds":["term.vibe.small-steps","term.vibe.rollback"],"topicIds":["vibe-coding.iteration.small-steps","vibe-coding.versioning.rollback"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
{"id":"term.vibe.diff","termType":"concept","displayName":{"zh-CN":"差异（diff）","en":"Diff"},"aliases":[{"text":"diff","lang":"en","matchType":"exact"},{"text":"差异","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"改动前后的逐行对比，是审查 AI 输出最可靠的入口，能暴露意外删除与越界修改。","en":"The line-by-line comparison before and after a change; the most reliable entry point for reviewing AI output, exposing accidental deletions and out-of-scope edits."},"syntaxRef":"syntax/prompt.json#diff","exampleIds":["example.vibe.diff-review-checklist"],"relatedTermIds":["term.vibe.code-review","term.vibe.verification"],"topicIds":["vibe-coding.review.diff"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
{"id":"term.vibe.code-review","termType":"concept","displayName":{"zh-CN":"代码审查","en":"Code review"},"aliases":[{"text":"code review","lang":"en","matchType":"exact"},{"text":"代码审查","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"按清单检查改动的范围、正确性、错误处理、测试与安全隐患，而不是只看能否运行。","en":"Checking a change against a checklist for scope, correctness, error handling, tests and security, not just whether it runs."},"syntaxRef":"syntax/prompt.json#code-review","exampleIds":["example.vibe.diff-review-checklist"],"relatedTermIds":["term.vibe.diff","term.vibe.human-in-the-loop"],"topicIds":["vibe-coding.review.diff"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
{"id":"term.vibe.automated-test","termType":"concept","displayName":{"zh-CN":"自动化测试","en":"Automated test"},"aliases":[{"text":"automated test","lang":"en","matchType":"exact"},{"text":"自动化测试","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"可重复运行、自动判定成功或失败的测试，是 AI 改动最直接的验证证据。","en":"Repeatable tests that automatically decide success or failure, the most direct verification evidence for AI changes."},"syntaxRef":"syntax/prompt.json#automated-test","exampleIds":["example.vibe.test-first-prompt","example.vibe.regression-command"],"relatedTermIds":["term.vibe.regression-test","term.vibe.test-evidence"],"topicIds":["vibe-coding.testing.automated"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
{"id":"term.vibe.regression-test","termType":"concept","displayName":{"zh-CN":"回归测试","en":"Regression test"},"aliases":[{"text":"regression test","lang":"en","matchType":"exact"},{"text":"回归测试","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"确认新改动没有破坏既有行为的测试；每次改动后都运行同一批用例。","en":"Tests confirming a change did not break existing behavior; run the same case set after every change."},"syntaxRef":"syntax/prompt.json#regression-test","exampleIds":["example.vibe.regression-command"],"relatedTermIds":["term.vibe.automated-test","term.vibe.test-evidence"],"topicIds":["vibe-coding.testing.automated"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
{"id":"term.vibe.test-evidence","termType":"concept","displayName":{"zh-CN":"测试证据","en":"Test evidence"},"aliases":[{"text":"test evidence","lang":"en","matchType":"exact"},{"text":"测试证据","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"真实运行产生的输出与退出码，可粘贴进提交或报告；预期输出不算证据。","en":"Real output and exit codes from an actual run, which can be pasted into a commit or report; expected output is not evidence."},"syntaxRef":"syntax/prompt.json#test-evidence","exampleIds":["example.vibe.regression-command"],"relatedTermIds":["term.vibe.automated-test","term.vibe.no-verify-no-claim"],"topicIds":["vibe-coding.testing.automated","vibe-coding.foundations.generate-vs-verify"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
{"id":"term.vibe.debugging-evidence","termType":"concept","displayName":{"zh-CN":"调试证据","en":"Debugging evidence"},"aliases":[{"text":"debugging evidence","lang":"en","matchType":"exact"},{"text":"调试证据","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"定位问题所需的可观察信息：复现步骤、完整报错、日志、改动前后对比，每一轮尝试都要新增证据。","en":"Observable information needed to locate a bug: reproduction steps, full errors, logs and before/after comparison, with every attempt adding evidence."},"syntaxRef":"syntax/prompt.json#debugging-evidence","exampleIds":["example.vibe.debug-evidence"],"relatedTermIds":["term.vibe.reproduction-steps","term.vibe.verification"],"topicIds":["vibe-coding.debugging.evidence"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
{"id":"term.vibe.reproduction-steps","termType":"concept","displayName":{"zh-CN":"复现步骤","en":"Reproduction steps"},"aliases":[{"text":"reproduction steps","lang":"en","matchType":"exact"},{"text":"复现步骤","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"能让问题稳定出现的环境、输入与操作顺序；不能稳定复现时要记录频率与条件。","en":"The environment, input and operation order that reliably triggers a bug; when it is not reliable, record frequency and conditions."},"syntaxRef":"syntax/prompt.json#reproduction-steps","exampleIds":["example.vibe.debug-evidence"],"relatedTermIds":["term.vibe.debugging-evidence"],"topicIds":["vibe-coding.debugging.evidence"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
{"id":"term.vibe.rollback","termType":"concept","displayName":{"zh-CN":"版本回滚","en":"Rollback"},"aliases":[{"text":"rollback","lang":"en","matchType":"exact"},{"text":"回滚","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"验证失败时把代码恢复到最近可用检查点，再重新分析问题，避免在错误基础上继续叠加改动。","en":"Restoring code to the last known-good checkpoint after a failed verification and re-analyzing, avoiding changes stacked on top of a mistake."},"syntaxRef":"syntax/prompt.json#rollback","exampleIds":["example.vibe.rollback-commands"],"relatedTermIds":["term.vibe.checkpoint","term.vibe.atomic-commit"],"topicIds":["vibe-coding.versioning.rollback"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
{"id":"term.vibe.checkpoint","termType":"concept","displayName":{"zh-CN":"检查点","en":"Checkpoint"},"aliases":[{"text":"checkpoint","lang":"en","matchType":"exact"},{"text":"检查点","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"验证通过并提交后形成的可回到的稳定状态，是回滚与继续迭代的锚点。","en":"A stable, returnable state created after verification passes and a commit is made; the anchor for rollback and further iteration."},"syntaxRef":"syntax/prompt.json#checkpoint","exampleIds":["example.vibe.rollback-commands"],"relatedTermIds":["term.vibe.rollback","term.vibe.atomic-commit"],"topicIds":["vibe-coding.iteration.small-steps","vibe-coding.versioning.rollback","vibe-coding.workflow.human-checkpoints"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
{"id":"term.vibe.dependency-lock","termType":"concept","displayName":{"zh-CN":"依赖锁定","en":"Dependency lock"},"aliases":[{"text":"dependency lock","lang":"en","matchType":"exact"},{"text":"lockfile","lang":"en","matchType":"exact"},{"text":"依赖锁定","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"固定依赖版本并提交 lock 文件，避免 AI 引入的依赖在后续安装时悄悄升级。","en":"Pinning dependency versions and committing the lockfile so dependencies introduced by AI do not silently upgrade later."},"syntaxRef":"syntax/prompt.json#dependency-lock","exampleIds":["example.vibe.dependency-audit"],"relatedTermIds":["term.vibe.secret-hygiene"],"topicIds":["vibe-coding.security.dependencies-secrets"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
{"id":"term.vibe.secret-hygiene","termType":"concept","displayName":{"zh-CN":"密钥卫生","en":"Secret hygiene"},"aliases":[{"text":"secret hygiene","lang":"en","matchType":"exact"},{"text":"密钥卫生","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"密钥只从环境变量或安全配置读取，不写进代码、prompt、日志与仓库；泄露后立即轮换。","en":"Secrets come only from environment variables or secure configuration, never code, prompts, logs or repositories; rotate immediately after a leak."},"syntaxRef":"syntax/prompt.json#secret-hygiene","exampleIds":["example.vibe.secrets-gitignore"],"relatedTermIds":["term.vibe.dependency-lock","term.vibe.human-in-the-loop"],"topicIds":["vibe-coding.security.dependencies-secrets"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
{"id":"term.vibe.plan-mode","termType":"concept","displayName":{"zh-CN":"计划优先","en":"Plan first"},"aliases":[{"text":"plan first","lang":"en","matchType":"exact"},{"text":"计划模式","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"先让 AI 只读分析并给出改动计划，人工确认后再进入编辑阶段。","en":"Having the AI perform read-only analysis and propose a plan first, entering the edit phase only after human confirmation."},"syntaxRef":"syntax/prompt.json#plan-mode","exampleIds":["example.vibe.plan-first-prompt"],"relatedTermIds":["term.vibe.requirement-clarification","term.vibe.human-in-the-loop"],"topicIds":["vibe-coding.workflow.plan-first"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"},
{"id":"term.vibe.human-in-the-loop","termType":"concept","displayName":{"zh-CN":"人在环中","en":"Human in the loop"},"aliases":[{"text":"human in the loop","lang":"en","matchType":"exact"},{"text":"人在环中","lang":"zh-CN","matchType":"exact"}],"definitions":{"zh-CN":"在关键节点由人确认与负责，AI 不能替代对提交、发布与破坏性操作的最终决定。","en":"Humans confirm and take responsibility at key points; AI cannot replace final decisions on commits, releases and destructive operations."},"syntaxRef":"syntax/prompt.json#human-in-the-loop","exampleIds":["example.vibe.human-checkpoint"],"relatedTermIds":["term.vibe.checkpoint","term.vibe.code-review"],"topicIds":["vibe-coding.workflow.human-checkpoints"],"source":"seed","contentVersion":"1.0.0","reviewStatus":"reviewed"}
]}
